# Normalize line endings on commit; check out with native EOLs.
* text=auto eol=lf

# Explicit text files (helps git diff/merge across platforms).
*.php       text diff=php
*.json      text
*.md        text
*.neon      text
*.xml       text
*.dist      text
*.yml       text
*.yaml      text
Makefile    text

# Files excluded from `composer archive` and Packagist dist downloads.
# Consumers installing this library don't need dev tooling, tests, or CI config.
/.github/             export-ignore
/tests/               export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/.php-cs-fixer.dist.php export-ignore
/.php-cs-fixer.cache  export-ignore
/.phpactor.json       export-ignore
/.phpunit.cache/      export-ignore
/.phpunit.result.cache export-ignore
/phpunit.xml.dist     export-ignore
/phpstan.neon.dist    export-ignore
/Makefile             export-ignore
/composer.lock        export-ignore
/CHANGELOG.md         export-ignore
